<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="HelloWorld Karl Khouri" Language="1033" Version="1.0.0" Manufacturer="Karl Khouri" UpgradeCode="CCE97DB4-11EC-4143-8231-0D5C640270F8">
    <Package InstallerVersion="200" Compressed="yes" InstallScope="perMachine" Description="A simple Hello World application" Manufacturer="Karl Khouri" />

    <Media Id="1" Cabinet="helloworld.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="HelloWorld">
          <Component Id="HelloWorldExe" Guid="49C7AAB3-2170-4767-8815-6A49BA473062" Win64="yes">
            <File Id="HelloWorldExe" Name="helloworld.exe" Source="helloworld.exe" KeyPath="yes" />
          </Component>
          <Component Id="ReadmeFile" Guid="926DC09D-ED4D-460B-9A0D-5EE7575C99FA" Win64="yes">
            <File Id="ReadmeFile" Name="README.md" Source="README.md" KeyPath="yes" />
          </Component>
          <Component Id="UserGuideFile" Guid="266229A3-66F3-456E-83B3-8EDF574398C2" Win64="yes">
            <File Id="UserGuideFile" Name="user_guide.txt" Source="user_guide.txt" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="HelloWorld" Level="1">
      <ComponentRef Id="HelloWorldExe" />
      <ComponentRef Id="ReadmeFile" />
      <ComponentRef Id="UserGuideFile" />
    </Feature>
  </Product>
</Wix>
